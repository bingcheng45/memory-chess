{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "memory-chess-gateway",
  "main": "worker.ts",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // next/server is CommonJS and reads __dirname, which Workers do not define.
  "define": { "__dirname": "\"/\"" },
  "services": [
    { "binding": "APP", "service": "memory-chess" },
    { "binding": "APP_LOCALE_DECIDED", "service": "memory-chess", "props": { "localeDecided": true } }
  ],
  "vars": {
    "SITE_ENV": "production",
    // Public: the same ID is in every page's HTML. The gateway counts AI crawlers for the whole site.
    "NEXT_PUBLIC_DATABUDDY_CLIENT_ID": "1b4dd0dc-cad9-47f1-bd14-78a832902515"
  },
  "observability": {
    "enabled": true
  }
}
